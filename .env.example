# =============================================================================
# .env.example — Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copie este archivo como .env y reemplace los valores.
# El archivo .env está en .gitignore: NUNCA se versionan secretos reales.
# =============================================================================

# ----- Base de datos (SQL Server en Docker) ----------------------------------
# Requisitos de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas,
# números y símbolos.
MSSQL_SA_PASSWORD=Cambie_Esta_Clave_2026!
# Logins de la aplicación (los crea db-init con permisos mínimos; ver
# database/seguridad/usuarios_aplicacion.sql). Misma política de complejidad,
# distintas entre sí y de MSSQL_SA_PASSWORD, sin comillas.
#   app_creditos_api     -> API REST
#   app_creditos_worker  -> worker de webhooks
DB_API_PASSWORD=Cambie_Clave_Api_2026!
DB_WORKER_PASSWORD=Cambie_Clave_Worker_2026!
# Puerto expuesto en el equipo anfitrión (para conectarse con SSMS / Azure Data Studio)
DB_PORT=14330
# Cargar usuarios y créditos de demostración (solo desarrollo/evaluación)
SEED_DEMO=true

# ----- API -------------------------------------------------------------------
API_PORT=3000
LOG_LEVEL=info
# Frontends autorizados por CORS (separados por coma). Solo hace falta para el
# servidor de desarrollo de Vite (5173); el frontend de Docker usa el mismo origen.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Documentación Swagger en http://localhost:3000/api/docs (desactivar en producción real)
API_DOCS_ENABLED=true

# ----- Frontend (Nginx) ---------------------------------------------------------
# Aplicación web en http://localhost:8080. Llama a la API por el mismo origen
# (/api), así que no necesita estar en CORS_ALLOWED_ORIGINS.
WEB_PORT=8080

# ----- Autenticación (JWT) ---------------------------------------------------
# Secreto para firmar los tokens: mínimo 32 caracteres aleatorios.
# Para generar uno en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Vigencia del token de acceso en minutos
JWT_EXPIRES_IN_MINUTES=60

# ----- Webhook -----------------------------------------------------------------
# Destino de la notificación "credito.creado". Por defecto, el receptor de
# prueba incluido; en producción, la URL real del sistema externo.
WEBHOOK_URL=http://webhook-receptor:4000/webhooks/creditos
# Secreto COMPARTIDO con el sistema externo para la firma HMAC-SHA256
# (mínimo 32 caracteres; distinto de JWT_SECRET). Genérelo igual que JWT_SECRET.
WEBHOOK_SECRET=reemplace-por-otro-secreto-aleatorio-de-32-caracteres
# Primera espera entre reintentos (se duplica en cada intento) y tope, en segundos
WEBHOOK_RETRY_BASE_SECONDS=10
WEBHOOK_RETRY_MAX_SECONDS=3600

# ----- Receptor de prueba (simula el sistema externo) --------------------------
RECEPTOR_PORT=4000
# normal | falla-temporal | caido | lento | rechazar  (también se cambia en caliente con PUT /modo)
RECEPTOR_MODO=normal
# En modo falla-temporal: cuántos intentos de cada evento responde con 503 antes de aceptar
RECEPTOR_FALLOS_POR_EVENTO=2
